# Copy to .env before `docker compose up`.

# How many downloads run at once, box-wide (across all users).
MAX_CONCURRENT_DOWNLOADS=2

# 0 = unlimited. KiB/s per download.
RATE_LIMIT_KIB=0

# Domain Caddy issues a TLS cert for. Use "localhost" for local/dev.
SITE_ADDRESS=localhost

# Comma-separated origins allowed to call the API. "*" (default) is fine
# behind Caddy on one domain; tighten to that exact origin if you ever split
# frontend and API across domains, e.g. https://ytpdl.example.com
CORS_ORIGINS=*

# --- Telegram bot ---
# Bot token from @BotFather (message it, /newbot, follow the prompts).
TELEGRAM_BOT_TOKEN=change-me

# api_id/api_hash from https://my.telegram.org/apps — NOT from @BotFather.
# These authenticate the self-hosted Local Bot API Server (docker-compose's
# telegram-bot-api service), which is what lets the bot send full videos
# (up to 2GB) instead of being capped at 50MB. Tied to your personal
# Telegram account but only used to run this server, not to read messages.
TELEGRAM_API_ID=change-me
TELEGRAM_API_HASH=change-me
