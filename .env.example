# Copy to .env before `docker compose up`.

# Signs login JWTs. Generate a real one:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Postgres password for the account database (docker-compose.yml wires this
# into DATABASE_URL for you). Pick something real.
POSTGRES_PASSWORD=change-me

# If set, /api/auth/register requires this code to create an account — the
# gate that keeps this from becoming an open public YouTube downloader the
# moment it's reachable from the internet. Leave blank only for a fully
# trusted private instance.
SIGNUP_INVITE_CODE=

# How many downloads run at once, box-wide (across all users).
MAX_CONCURRENT_DOWNLOADS=2

# 0 = unlimited. KiB/s per download.
RATE_LIMIT_KIB=0

# Domain Caddy issues a TLS cert for. Use "localhost" for local/dev.
SITE_ADDRESS=localhost

# Comma-separated origins allowed to call the API. "*" (default) is fine
# behind Caddy on one domain; tighten to that exact origin if you ever split
# frontend and API across domains, e.g. https://ytpdl.example.com
CORS_ORIGINS=*
